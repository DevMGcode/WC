# =====================================================================
# .env.prod — Orionix Gol | PRODUCCIÓN (Azure VM)
# =====================================================================
# 1. Copia este archivo:  cp .env.prod.example .env.prod
# 2. Rellena TODOS los valores marcados con <CAMBIAR>
# 3. NUNCA commitees .env.prod al repositorio
# =====================================================================

# ----------------------------------------------------------------------
# Base de datos PostgreSQL
# En producción el host es "postgres" (nombre del servicio Docker)
# ----------------------------------------------------------------------
DB_URL=jdbc:postgresql://postgres:5432/worldcup2026_db
DB_USERNAME=postgres
DB_PASSWORD=<CAMBIAR_usa_una_contraseña_segura_min20chars>

# Misma contraseña — la usa el servicio postgres para inicializar la BD
POSTGRES_PASSWORD=<CAMBIAR_misma_que_DB_PASSWORD>

# ----------------------------------------------------------------------
# JWT — genera tu propio secret con:
#   openssl rand -base64 48
# NUNCA reutilices el secret de dev
# ----------------------------------------------------------------------
JWT_SECRET=<CAMBIAR_openssl_rand_base64_48>

# ----------------------------------------------------------------------
# API-Football
# ----------------------------------------------------------------------
APIFOOTBALL_BASE_URL=https://v3.football.api-sports.io
APIFOOTBALL_API_KEY=<CAMBIAR_tu_api_key_de_api-sports.io>
APIFOOTBALL_MODE=DIRECT

# ----------------------------------------------------------------------
# Scheduler — en producción activar para sincronizar datos en vivo
# ----------------------------------------------------------------------
SYNC_ENABLED=true
LIVE_POLL_MS=30000

# ----------------------------------------------------------------------
# Mail — Gmail con App Password (no la contraseña normal de Gmail)
# Cómo generar App Password:
#   Google Account → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
# ----------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<CAMBIAR_tu-cuenta@gmail.com>
MAIL_PASSWORD=<CAMBIAR_app_password_de_16_chars>

# ----------------------------------------------------------------------
# Verificación de email — OBLIGATORIO true en producción
# ----------------------------------------------------------------------
EMAIL_VERIFICATION_REQUIRED=true

# ----------------------------------------------------------------------
# URL del frontend — dominio real de Azure (o dominio propio)
# Ejemplos:
#   Azure App Service:  https://orionixgol.azurewebsites.net
#   Azure VM con nginx: https://orionixgol.com
#   Azure Container:    https://orionixgol.<region>.azurecontainerapps.io
# ----------------------------------------------------------------------
FRONTEND_URL=https://<CAMBIAR_tu-dominio>

# ----------------------------------------------------------------------
# URLs del frontend Next.js — se "hornean" en el build
# Deben coincidir con FRONTEND_URL
# ----------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://<CAMBIAR_tu-dominio>/api
NEXT_PUBLIC_APP_URL=https://<CAMBIAR_tu-dominio>
NEXT_PUBLIC_WS_URL=wss://<CAMBIAR_tu-dominio>/ws

# ----------------------------------------------------------------------
# GlitchTip — error tracking open-source (Sentry SDK-compatible)
# Crea cuenta gratuita en https://app.glitchtip.com (1.000 eventos/mes free)
# Copia el DSN del proyecto y pégalo aquí. Deja vacío para desactivar.
# ----------------------------------------------------------------------
NEXT_PUBLIC_GLITCHTIP_DSN=https://50fa4312c0e24ee7a789d0ac328963f5@app.glitchtip.com/24132

# ----------------------------------------------------------------------
# Google Analytics 4 — Measurement ID (formato G-XXXXXXXXXX)
# Crea property en https://analytics.google.com → Admin → Data Streams
# ----------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-FJGDNVCDL5
