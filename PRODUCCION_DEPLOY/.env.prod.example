# =====================================================================
# .env.prod — Orionix Gol | PRODUCCIÓN (Azure VM)
# =====================================================================
# 1. Copia este archivo:  cp .env.prod.example .env.prod
# 2. Rellena TODOS los valores marcados con <CAMBIAR>
# 3. NUNCA commitees .env.prod al repositorio
# =====================================================================

# ----------------------------------------------------------------------
# Base de datos PostgreSQL
# En producción el host es "postgres" (nombre del servicio Docker)
# ----------------------------------------------------------------------
DB_URL=jdbc:postgresql://postgres:5432/worldcup2026_db
DB_USERNAME=postgres
DB_PASSWORD=<CAMBIAR_usa_una_contraseña_segura_min20chars>

# Misma contraseña — la usa el servicio postgres para inicializar la BD
POSTGRES_PASSWORD=<CAMBIAR_misma_que_DB_PASSWORD>

# ----------------------------------------------------------------------
# JWT — genera tu propio secret con:
#   openssl rand -base64 48
# NUNCA reutilices el secret de dev
# ----------------------------------------------------------------------
JWT_SECRET=<CAMBIAR_openssl_rand_base64_48>

# ----------------------------------------------------------------------
# API-Football
# ----------------------------------------------------------------------
APIFOOTBALL_BASE_URL=https://v3.football.api-sports.io
APIFOOTBALL_API_KEY=<CAMBIAR_tu_api_key_de_api-sports.io>
APIFOOTBALL_MODE=DIRECT

# ----------------------------------------------------------------------
# Scheduler — en producción activar para sincronizar datos en vivo
# ----------------------------------------------------------------------
SYNC_ENABLED=true
LIVE_POLL_MS=30000

# ----------------------------------------------------------------------
# Mail — Gmail con App Password (no la contraseña normal de Gmail)
# Cómo generar App Password:
#   Google Account → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
# ----------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<CAMBIAR_tu-cuenta@gmail.com>
MAIL_PASSWORD=<CAMBIAR_app_password_de_16_chars>

# ----------------------------------------------------------------------
# Verificación de email — OBLIGATORIO true en producción
# ----------------------------------------------------------------------
EMAIL_VERIFICATION_REQUIRED=true

# ----------------------------------------------------------------------
# Admin — el seed crea admin@example.com con password "admin" (hash público).
# OBLIGATORIO en producción: define una contraseña fuerte aquí y activa el
# fallo de arranque para que la app NO inicie si el admin sigue por defecto.
# ----------------------------------------------------------------------
ADMIN_INITIAL_PASSWORD=<CAMBIAR_password_admin_fuerte>
FAIL_ON_DEFAULT_ADMIN=true

# ----------------------------------------------------------------------
# Endurecimiento en producción
#   TRUST_PROXY=true            → la app está detrás de nginx (X-Forwarded-For)
#   CORS_ALLOW_DEV_ORIGINS=false → solo el dominio real, sin localhost/ngrok
# ----------------------------------------------------------------------
TRUST_PROXY=true
CORS_ALLOW_DEV_ORIGINS=false

# ----------------------------------------------------------------------
# URL del frontend — dominio real de Azure (o dominio propio)
# Ejemplos:
#   Azure App Service:  https://orionixgol.azurewebsites.net
#   Azure VM con nginx: https://orionixgol.com
#   Azure Container:    https://orionixgol.<region>.azurecontainerapps.io
# ----------------------------------------------------------------------
FRONTEND_URL=https://<CAMBIAR_tu-dominio>

# ----------------------------------------------------------------------
# URLs del frontend Next.js — se "hornean" en el build
# Deben coincidir con FRONTEND_URL
# ----------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://<CAMBIAR_tu-dominio>/api
NEXT_PUBLIC_APP_URL=https://<CAMBIAR_tu-dominio>
NEXT_PUBLIC_WS_URL=wss://<CAMBIAR_tu-dominio>/ws

# ----------------------------------------------------------------------
# GlitchTip — error tracking open-source (Sentry SDK-compatible)
# Crea cuenta gratuita en https://app.glitchtip.com (1.000 eventos/mes free)
# Copia el DSN del proyecto y pégalo aquí. Deja vacío para desactivar.
# ----------------------------------------------------------------------
NEXT_PUBLIC_GLITCHTIP_DSN=<CAMBIAR_tu_dsn_de_glitchtip_o_deja_vacio>

# ----------------------------------------------------------------------
# Google Analytics 4 — Measurement ID (formato G-XXXXXXXXXX)
# Crea property en https://analytics.google.com → Admin → Data Streams
# ----------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=<CAMBIAR_G-XXXXXXXXXX_o_deja_vacio>

# ----------------------------------------------------------------------
# Mercado Pago — Pasarela de pago en producción
# Panel: mercadopago.com.co/developers/panel → Tu app → Credenciales de producción
# ----------------------------------------------------------------------
MERCADO_PAGO_MODE=real

# Access Token PRODUCCIÓN — empieza con APP_USR- (PRIVADO, nunca al repo)
MERCADO_PAGO_ACCESS_TOKEN=<CAMBIAR_APP_USR-tu-access-token>

# Public Key PRODUCCIÓN — empieza con APP_USR- (puede ser pública)
MERCADO_PAGO_PUBLIC_KEY=<CAMBIAR_APP_USR-tu-public-key>

# Webhook secret — lo ves en: Panel MP → Tu app → Webhooks → "Clave secreta"
MERCADO_PAGO_WEBHOOK_SECRET=<CAMBIAR_clave_secreta_del_panel_webhooks>

# URL donde MP notifica los pagos (la que configuraste en el panel webhooks)
MERCADO_PAGO_NOTIFICATION_URL=https://orionixgol.com/api/v1/public/payments/mercadopago/webhook

# Public Key inyectada al bundle Next.js durante el build
NEXT_PUBLIC_MP_PUBLIC_KEY=<CAMBIAR_APP_USR-tu-public-key>

# ── Web Push (VAPID) — notificaciones push gratis vía los servicios de los
# navegadores (Google/Mozilla/Apple/WNS). No cuesta nada ni usa terceros.
# Genera tu propio par de claves con:  npx web-push generate-vapid-keys
# La clave pública la pide el frontend al backend en runtime; no va al build.
VAPID_PUBLIC_KEY=<CAMBIAR_clave_publica_vapid>
VAPID_PRIVATE_KEY=<CAMBIAR_clave_privada_vapid>
VAPID_SUBJECT=mailto:admin@orionixgol.com
