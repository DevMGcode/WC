# ── STAGE 1: Build con Maven ──────────────────────────────────────────────────
# Usamos la imagen oficial de Maven (no el wrapper ./mvnw) porque el directorio
# .mvn/wrapper/ nunca se versionó en este repo. Es además consistente con
# Dockerfile.dev, que también apt-installs maven en lugar del wrapper.
FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /app

# Layer caching: copiamos primero el pom para que las dependencias se cacheen
# en una capa independiente del código fuente.
COPY pom.xml .
RUN mvn dependency:go-offline -B --no-transfer-progress || true

COPY src ./src

RUN mvn package -DskipTests --no-transfer-progress

# ── STAGE 2: Runtime solo JRE (imagen más liviana) ────────────────────────────
FROM eclipse-temurin:21-jre
WORKDIR /app

RUN addgroup --system --gid 1001 spring && \
    adduser --system --uid 1001 --ingroup spring spring

COPY --from=builder /app/target/*.jar app.jar

# logback-spring.xml escribe a logs/orionix-gol.log (path relativo al WORKDIR).
# Hay que crear el directorio y dárselo al usuario `spring` ANTES del USER,
# porque el usuario no-root no tiene permisos para crearlo en runtime.
RUN mkdir -p /app/logs && chown -R spring:spring /app /app/logs

USER spring
EXPOSE 8080

ENTRYPOINT ["java", \
  "-XX:+UseContainerSupport", \
  "-XX:MaxRAMPercentage=75.0", \
  "-jar", "app.jar"]
