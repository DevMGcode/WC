# Environment Variables

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# App public URL (used for OG images and share links)
# En local: http://localhost:3000 | En Azure: https://orionixgol.azurewebsites.net
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Google Analytics 4 (Measurement ID, formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-FJGDNVCDL5

# Optional: Feature Flags
NEXT_PUBLIC_ENABLE_LIVE_TRACKING=false
NEXT_PUBLIC_ENABLE_VIDEO_HIGHLIGHTS=false
NEXT_PUBLIC_ENABLE_MONETARY_BETTING=false

# ── Binance Pay ────────────────────────────────────────────────────────────────
# El backend gestiona las credenciales — NUNCA usar NEXT_PUBLIC_ para estos valores.
# BINANCE_PAY_MERCHANT_ID=
# BINANCE_PAY_API_KEY=
# BINANCE_PAY_API_SECRET=

# ── Binance Connect ────────────────────────────────────────────────────────────
# URL del SDK (verificar versión vigente en docs oficiales de Binance Connect)
NEXT_PUBLIC_BINANCE_CONNECT_SDK_URL=https://public.bnbstatic.com/static/js/connect-sdk/binance-connect.min.js
# El backend firma las sesiones con HMAC-SHA512 — NUNCA usar NEXT_PUBLIC_ para estos.
# BINANCE_CONNECT_MERCHANT_CODE=
# BINANCE_CONNECT_API_SECRET=

# Optional: GlitchTip (open-source error tracking, Sentry SDK-compatible)
# Crea cuenta en https://app.glitchtip.com y copia el DSN del proyecto
NEXT_PUBLIC_GLITCHTIP_DSN=

# Optional: Sportmonks API (if frontend needs direct access)
# NEXT_PUBLIC_SPORTMONKS_API_KEY=
