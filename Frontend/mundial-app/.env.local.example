# Environment Variables

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# App public URL (used for OG images and share links)
# En local: http://localhost:3000 | En Azure: https://orionixgol.azurewebsites.net
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Analytics
NEXT_PUBLIC_GA_ID=

# Optional: Feature Flags
NEXT_PUBLIC_ENABLE_LIVE_TRACKING=false
NEXT_PUBLIC_ENABLE_VIDEO_HIGHLIGHTS=false
NEXT_PUBLIC_ENABLE_MONETARY_BETTING=false

# Optional: Sentry for error tracking
NEXT_PUBLIC_SENTRY_DSN=

# Optional: Sportmonks API (if frontend needs direct access)
# NEXT_PUBLIC_SPORTMONKS_API_KEY=
