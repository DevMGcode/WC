# =====================================================================
# .env.example — Mundial 2026 Backend
# =====================================================================
# Cópialo a .env y rellena los valores reales para tu entorno local:
#
#     cp .env.example .env
#
# NUNCA commitees el archivo .env (ya está en .gitignore).
# Secretos sensibles (JWT_SECRET, APIFOOTBALL_API_KEY) los compartes
# por gestor de contraseñas (1Password, Bitwarden) o gestor de secretos
# del equipo, NUNCA por Slack/Email/Git.
# =====================================================================

# ----------------------------------------------------------------------
# Base de datos PostgreSQL
# ----------------------------------------------------------------------
# Para desarrollo local con docker-compose.db.yml estos defaults sirven.
DB_URL=jdbc:postgresql://localhost:5434/worldcup2026_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ----------------------------------------------------------------------
# JWT
# ----------------------------------------------------------------------
# Genera tu propio secret (mínimo 32 bytes para HS256):
#     openssl rand -base64 48
# NUNCA uses el valor del ejemplo, NUNCA reutilices el de otro entorno.
JWT_SECRET=REEMPLAZA_CON_openssl_rand_base64_48

# ----------------------------------------------------------------------
# API-Football (api-sports.io)
# ----------------------------------------------------------------------
# Pide la API key del equipo en [1Password / Vault / Doppler — define].
# Si vas a desarrollar sin consumir cuota, deja APIFOOTBALL_API_KEY vacío
# y pon SYNC_ENABLED=false; el backend arranca igual.
APIFOOTBALL_BASE_URL=https://v3.football.api-sports.io
APIFOOTBALL_API_KEY=
APIFOOTBALL_MODE=DIRECT

# ----------------------------------------------------------------------
# Scheduler de sincronización con API-Football
# ----------------------------------------------------------------------
# false → no consume cuota (recomendado en desarrollo)
# true  → el scheduler hace polling cada 15s (revisa tournament.sync.fixed-rate-ms)
SYNC_ENABLED=false

# ======================================================================
# Mercado Pago — pagos del Pase Mundial Premium
# ======================================================================
#
# MODO DE OPERACIÓN
# ─────────────────
# MERCADO_PAGO_MODE controla cómo se comporta el backend en pagos:
#
#   "mock" (default) → El backend NO llama a Mercado Pago real. Genera
#                      preferencias falsas y la suscripción queda PENDING.
#                      Útil para desarrollo de UI/flow sin necesidad de
#                      credenciales. Para activar la sub manualmente:
#                          UPDATE subscription SET status='ACTIVE',
#                            started_at=now(),
#                            expires_at='2026-07-19 23:59:59+00'
#                            WHERE id=<id>;
#
#   "real" → El backend habla con Mercado Pago real (sandbox o producción
#            según las credenciales). Crea preferencia, devuelve init_point.
#            Si quieres recibir el webhook automático en local, necesitas
#            ngrok (ver sección abajo).
#
MERCADO_PAGO_MODE=mock

# CREDENCIALES (solo necesarias si MERCADO_PAGO_MODE=real)
# ────────────────────────────────────────────────────────
# Sandbox de pruebas: panel.mercadopago.com.co → Tus integraciones →
#   Producto "Checkout Pro" → Credenciales → "Credenciales de prueba".
# Producción: usar el bloque "Credenciales de producción" (NUNCA commitear).
#
# Los valores TEST-* son de sandbox; APP_USR-* son de producción.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=

# Secret del webhook (panel de MP → Webhooks → "Configurar notificaciones").
# Si se deja vacío, el backend NO valida la firma — útil en dev cuando
# todavía no configuraste el webhook. En producción es OBLIGATORIO.
MERCADO_PAGO_WEBHOOK_SECRET=

# URL pública donde MP enviará las notificaciones de pago.
# ────────────────────────────────────────────────────────
# En DESARROLLO LOCAL con ngrok:
#   1) Instala ngrok: https://ngrok.com/download
#   2) Levanta el backend: docker compose -f docker-compose.dev.yml up backend
#   3) En otra terminal: ngrok http 8080
#   4) Copia la URL https://xxxx-xxxx.ngrok-free.app que te dé y pégala aquí
#      añadiendo el path del webhook:
#        MERCADO_PAGO_NOTIFICATION_URL=https://xxxx-xxxx.ngrok-free.app/api/v1/public/payments/mercadopago/webhook
#   5) En el panel de MP → Webhooks, registra esa misma URL.
#   6) Reinicia el backend para que tome la variable.
#   7) Haz un pago de prueba — verás el webhook llegar al backend y la
#      suscripción cambiará de PENDING → ACTIVE automáticamente, sin
#      necesidad de UPDATE manual.
#
# Si la dejas vacía, MP no envía webhook → tendrás que activar la
# suscripción a mano con SQL (ver sección "mock" arriba).
#
# En PRODUCCIÓN (AWS): NO se setea aquí. Ver PRODUCCION_DEPLOY/.env.prod.example
# y PRODUCCION_DEPLOY/INSTRUCCIONES_AWS.md — allí va el dominio público real,
# tipo https://api.tudominio.com/api/v1/public/payments/mercadopago/webhook
MERCADO_PAGO_NOTIFICATION_URL=

# ----------------------------------------------------------------------
# Frontend URL (para redirecciones de pago: success / failure / pending)
# ----------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
