# =====================================================================
# .env.example — Mundial 2026 Backend
# =====================================================================
# Cópialo a .env y rellena los valores reales para tu entorno local:
#
#     cp .env.example .env
#
# NUNCA commitees el archivo .env (ya está en .gitignore).
# Secretos sensibles (JWT_SECRET, APIFOOTBALL_API_KEY) los compartes
# por gestor de contraseñas (1Password, Bitwarden) o gestor de secretos
# del equipo, NUNCA por Slack/Email/Git.
# =====================================================================

# ----------------------------------------------------------------------
# Base de datos PostgreSQL
# ----------------------------------------------------------------------
# Para desarrollo local con docker-compose.db.yml estos defaults sirven.
DB_URL=jdbc:postgresql://localhost:5434/worldcup2026_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ----------------------------------------------------------------------
# JWT
# ----------------------------------------------------------------------
# Genera tu propio secret (mínimo 32 bytes para HS256):
#     openssl rand -base64 48
# NUNCA uses el valor del ejemplo, NUNCA reutilices el de otro entorno.
JWT_SECRET=REEMPLAZA_CON_openssl_rand_base64_48

# ----------------------------------------------------------------------
# API-Football (api-sports.io)
# ----------------------------------------------------------------------
# Pide la API key del equipo en [1Password / Vault / Doppler — define].
# Si vas a desarrollar sin consumir cuota, deja APIFOOTBALL_API_KEY vacío
# y pon SYNC_ENABLED=false; el backend arranca igual.
APIFOOTBALL_BASE_URL=https://v3.football.api-sports.io
APIFOOTBALL_API_KEY=
APIFOOTBALL_MODE=DIRECT

# ----------------------------------------------------------------------
# Scheduler de sincronización con API-Football
# ----------------------------------------------------------------------
# false → no consume cuota (recomendado en desarrollo)
# true  → el scheduler hace polling cada 15s (revisa tournament.sync.fixed-rate-ms)
SYNC_ENABLED=false
